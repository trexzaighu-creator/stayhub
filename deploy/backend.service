[Unit]
Description=Hostel API (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/hostel/backend_django
EnvironmentFile=/opt/hostel/backend_django/.env
ExecStart=/usr/bin/gunicorn -w 4 -b 127.0.0.1:8000 backend_django.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
