# Django Production Environment Variables

# Security
DJANGO_SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=0
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hostel_db

# Logging
LOG_LEVEL=INFO

# CORS (for production, specify your frontend domain)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
