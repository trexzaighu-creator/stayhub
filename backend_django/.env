# Local env copied from production template for verification
DJANGO_SECRET_KEY=m9X8sZ2QfK7pR4tY1uVbN3cW6eH0jL5oPqR8sT2uVbN7yZ4xC1aB0cD9eF6gH3
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database (update to your production DB)
# For local smoke test we use SQLite; leave DB_ENGINE empty
DB_ENGINE=
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Logging
LOG_LEVEL=INFO
